    {
      "category": "successful_outcome",
      "method_key": "successful_outcome:7",
      "source_line": 187,
      "original_text": "⑦马星当令或被冲时为应期；",
      "excerpt_sha256": "498aa2f725b397dcece267af2122cae07e899856e0602a556060ff81e7c43333",
      "conditions": {
