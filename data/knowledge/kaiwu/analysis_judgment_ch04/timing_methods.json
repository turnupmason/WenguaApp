      }
    },
    {
      "category": "failed_outcome",
      "method_key": "failed_outcome:1",
      "source_line": 197,
      "original_text": "①用神休、囚、死、墓、绝之时为应期；",
      "excerpt_sha256": "befb5a5867e4a8c3eb83e29e8a1e8f71addb5540102b00b1dc99c1af8c7cc742",
      "conditions": {
