    {
      "category": "failed_outcome",
      "method_key": "failed_outcome:4",
      "source_line": 200,
      "original_text": "④用神被合者，以刑、冲之时为应期，用神逢刑、冲者，以合时为应期；",
      "excerpt_sha256": "a59dc366f866856656b5ad4c3ad4123191054f32e9c9744c023e0e21eb0d0645",
      "conditions": {
        "after_success_failure_is_classified": true,
        "geng_applies_to_stopping_recovery": false,
        "source_line": 200,
        "original_is_not_a_fully_specified_calendar_ephemeris": true,
        "no_blind_accuracy_claim": true
      }
    },
    {
      "category": "failed_outcome",
      "method_key": "failed_outcome:5",
      "source_line": 201,
      "original_text": "⑤马星当令或被冲之时为应期；",
      "excerpt_sha256": "0d24ed9abdac6521944ed325a013c22d5c90ae141d62db67730e9331498ec67e",
      "conditions": {
        "after_success_failure_is_classified": true,
