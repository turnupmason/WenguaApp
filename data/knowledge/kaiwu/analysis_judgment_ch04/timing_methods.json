        "no_blind_accuracy_claim": true
      }
    },
    {
      "category": "failed_outcome",
      "method_key": "failed_outcome:6",
      "source_line": 202,
      "original_text": "⑥值使门或时干落宫，该宫所含的数，往往是事物成败的期限，即所需的时间，比如几年、几月、几日、几时等。值使门或时干落宫所临之干，有时也是应期。",
      "excerpt_sha256": "1f0b7fb535706a56b66b0fa61a80e6f759ba9d64d31280f1a04de146d4c700eb",
      "conditions": {
        "after_success_failure_is_classified": true,
        "geng_applies_to_stopping_recovery": false,
