    {
      "category": "failed_outcome",
      "method_key": "failed_outcome:2",
      "source_line": 198,
      "original_text": "②忌神旺相、当令，用神受克之时为应期；",
      "excerpt_sha256": "a2345cdf3b578a6d61d623e493999823af21781be79c31b328bc0ca9c23cb351",
      "conditions": {
