      "relation": "additional_exposition",
      "track": "kaiwu:health:v1:health_author_step"
    },
    {
      "concept_id": "health:three_a:step:2",
      "kind": "health_author_step",
      "line": 113,
      "original": "(2)日干甲午辛为病鸡，落巽宫，为死墓之地，又逢死门，大凶。辛+丙，测病不愈。",
      "source_sha": "598a60dd0d8a64a696dcae011e944a9f07668d7a2b737f527d48f380140ad238",
      "meta": {
        "topic": "prior_to_book_feedback",
