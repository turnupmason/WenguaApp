      "steps": [
        {
          "order": 1,
          "stage": "resolve_query",
          "instruction": "先识别正在谈对象、双方是否已有相识/接触以及问测人是本人或父母；不能盲猜来意。",
          "required_output": "subject_and_target_event"
        },
        {
          "order": 2,
          "stage": "role_bind",
          "instruction": "问者≠婚恋当事人时先绑定本人年命及其对象年命；代测儿女优先查看时干、乙庚、六合及实际年命的相对证据。",
          "required_output": "person_role_map"
        },
        {
          "order": 3,
          "stage": "select_primary_secondary",
          "instruction": "乙/庚为传统候选，结合日时干、双方年命和六合，确定这一次用来代表谁、谁主动，记录九宫位置。",
          "required_output": "symbol_and_palace_selection"
        },
        {
          "order": 4,
          "stage": "evaluate_support",
          "instruction": "检验两方宫位生克比和、门星神旺衰、六合及内外盘、相合或太岁助力是否形成实际促进。",
          "required_output": "supporting_trace"
        },
        {
          "order": 5,
          "stage": "evaluate_counterevidence",
          "instruction": "检验年命六仪击刑、空亡、入墓、门迫、伏吟、对方不积极、家长阻挠等；《开悟》两个对象不成却次年另成不能混为一个对象。",
          "required_output": "contradiction_trace"
        },
        {
          "order": 6,
          "stage": "form_outcome",
          "instruction": "对指定双方给出能谈成/不能谈成/延迟以及可能由谁推动，避免泛指未来总能遇到对象。",
          "required_output": "decisive_traditional_outcome"
        },
        {
          "order": 7,
          "stage": "calculate_timing",
          "instruction": "按支持成立的目标选择乙庚/六合/年命可应的月令、空亡填冲、旺相及值使/日时，准确给出交往关系确立的期间，反馈日期不准倒灌。",
          "required_output": "primary_computed_time_window"
        },
        {
          "order": 8,
          "stage": "write_and_audit",
          "instruction": "约200字先说该对象结果与首选时间，再点明最强两项证据与重要反证，引用古籍仅作内部依据。",
          "required_output": "natural_200_hanzi_with_full_audit"
        }
      ]
    },
