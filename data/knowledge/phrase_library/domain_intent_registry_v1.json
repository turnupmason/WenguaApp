  "routing": {
    "new_question_type_not_covered": "extend_taxonomy_from_real_user_question_without_inventing_new_rule",
    "multi_intent": "decompose_to_distinct_outcome_and_timing_targets_same_chart_not_necessarily_distinct_independent_case",
    "unknown": "return_specific_missing_evidence_not_generic_hedge"
