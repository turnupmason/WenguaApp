{
  "schema": "WenguaApp question_intent_registry_v1",
  "status": "design_only_not_mass_precomputed_phrases",
  "principle": "A domain contains subquestions; every completed real chart requires dynamic question-specific yongshen, case reasoning, forecast conclusion and computed applicable timing. GPT only verbalizes approved structured result.",
  "sequence": [
    "verify_original_nine_palace",
    "compute_every_physical_factor",
    "resolve_querent_subject_partner_relationships",
    "classify_intent_and_target_event",
    "retrieve_domain_and_intent_author_methods_and_errors",
    "select_primary_secondary_yongshen",
    "evidence_support_counter_and_conflicts",
    "compute_event-specific_outcome",
    "derive_and_choose_applicable_calendar_timing",
    "human_polish_chinese_approximately_200_chars",
    "persist_case_independent_instance_with_rule_version"
  ],
  "source_truth": "194 source-book cases, 43 book sections, existing marriage phrase V1.1 draft (4 prototypes, 0 verified chart instances)",
  "coverage": {
    "unique_cast_state_index": 1080,
    "year_birth_ganzhi": 60,
    "age_band": 3,
    "sex": 2,
    "per_domain_base_contexts": 388800,
    "preapproved_statements": 0
  },
  "not_all_phrases_precomputed": true,
  "review_policy": {
    "book_author_historical_cases": "accepted_as_book_source_per_user",
    "new_method_candidate": "draft_until_rule_checked",
    "gpt_phrase": "human_style_only_not_authoritative",
    "calendar_date": "must_be_calculated_not_invented",
    "external_future_accuracy": "not_guaranteed"
  },
