  ],
  "first_section_scenarios": [
    {
      "group": 1,
      "name": "交易",
      "role_keys": "日干买主/时干卖主/六合中介",
      "condition_notes": "双方法之间生克、空亡、经纪人偏向"
    },
    {
      "group": 2,
      "name": "投资",
      "role_keys": "甲子戊为资本、生门为利息",
      "condition_notes": "旺相、得奇格、吉凶星、内外盘与应期"
    },
    {
      "group": 3,
      "name": "买卖货物",
      "role_keys": "日干为买或卖方、时干为货物",
      "condition_notes": "货物质量、买卖能否成交及资本利息"
    },
    {
      "group": 4,
      "name": "地产",
      "role_keys": "生门房屋、死门地皮、开门商场",
      "condition_notes": "产权/租赁/开店是不同问事，不得任意互代"
    },
    {
      "group": 5,
      "name": "合伙",
      "role_keys": "地盘日干我方、天盘上临干对方",
      "condition_notes": "也可日干本人、时干合伙人，比较主客"
    },
    {
      "group": 6,
      "name": "金融",
      "role_keys": "值符银行、值使借款人、天乙欠款人",
      "condition_notes": "贷入和放贷须分两套方法，方位星客主备选"
    },
    {
      "group": 7,
      "name": "讨债",
      "role_keys": "伤门讨债者、值符债主、天乙欠债人",
      "condition_notes": "财力与愿意还款、应期、出行安全分开"
    },
    {
      "group": 8,
      "name": "营销",
      "role_keys": "六合代理商、景门丁奇广告",
      "condition_notes": "来自原书个案的策略性解释，并不作为普遍经济规律"
    },
    {
      "group": 9,
      "name": "应期",
      "role_keys": "内外盘、甲子戊、生门、地盘时干宫地支",
      "condition_notes": "伏吟择生门冲宫、空亡填实和时令需核原书条件"
    },
    {
      "group": 10,
      "name": "抽奖",
      "role_keys": "伤门汽车、时干摸奖人、开门主办方",
      "condition_notes": "源第十二例三张实际不同小时盘，另两日只有文字解释"
    }
  ],
