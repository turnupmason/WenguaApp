        95
      ],
      "summary": "丁壬震例参兑宫时段的冲，不等于任意干合都直接取宫数。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T077": {
      "lines": [
        95,
        96
      ],
      "summary": "天干合或暗支合的冲候选有多方，按上下文与先遇筛选。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T078": {
      "lines": [
        96
      ],
      "summary": "六甲暗支与宫支合时，讲义强调外来暗支的冲较常应、本宫支不易冲走；不把所有对冲平权。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T079": {
      "lines": [
        97
      ],
      "summary": "无前述限制时，依事件方向和用神需要查生旺墓绝、生逢生、克逢克。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T080": {
      "lines": [
        98
      ],
      "summary": "伏吟局可参冲期，仍合参具体应事用神与上位条件，不能只按局名定日。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T081": {
      "lines": [
        98
      ],
      "summary": "反吟局可参合期，不能无视空、马、墓及符使适用背景。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T082": {
      "lines": [
        99
      ],
      "summary": "日支、时支的合刑冲克害仅列参考，不能自动提为主应期。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T083": {
      "lines": [
        100,
        101
      ],
      "summary": "非阻截领域只有应事用神恰临相应庚格时才作特殊候选；找工作庚加月干例保留为条件例。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T084": {
      "lines": [
        104
      ],
      "summary": "六甲值符落对冲宫的例子，按值符外来支之合定期，不混普通用神的另一段例外。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T085": {
      "lines": [
        105
      ],
      "summary": "甲戌坤、甲子震、甲寅巽的值符刑例按外来支参合。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T086": {
      "lines": [
        106
      ],
      "summary": "值符落旬空按出旬、空支填实及阴阳比的原段说明；不是普通宫空任意冲填的完全同义。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T087": {
      "lines": [
        107,
        108
      ],
      "summary": "在已排除值符冲、刑、空后查天盘六仪暗支冲合，再无冲合才查星门生克。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T088": {
      "lines": [
        110
      ],
      "summary": "确需值符／值使办的事才提升相应落宫；这不是值使宫数定时长的同一个方法。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T089": {
      "lines": [
        111
      ],
      "summary": "用神和值使同宫可有已启动／宜执行之象，但值使空或墓则不能据此认定已经发生。",
      "evidence_level": "user_supplied_explicit_or_contextual_statement"
    },
    "T090": {
